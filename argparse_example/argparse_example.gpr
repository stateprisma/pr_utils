with "config/argparse_example_config.gpr";
with "../press_utils.gpr";
project Argparse_Example is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Argparse_Example_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("argparse_example.adb");

   package Compiler is
      for Default_Switches ("Ada") use Argparse_Example_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Argparse_Example;
